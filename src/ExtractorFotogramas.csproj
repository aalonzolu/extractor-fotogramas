<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net45</TargetFramework>
    <LangVersion>7.3</LangVersion>
    <AssemblyName>ExtractorFotogramas</AssemblyName>
    <RootNamespace>ExtractorFotogramas</RootNamespace>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <DebugType>none</DebugType>
    <Version>1.6.0</Version>
    <Product>Extractor de Fotogramas</Product>
    <AssemblyTitle>Extractor de Fotogramas</AssemblyTitle>
    <Description>Extracción de fotogramas por segundo completo con FFmpeg y reporte de hashes SHA-256 y SHA-512</Description>
    <Copyright>Copyright (c) 2026 Andres Alonzo. Licencia MIT.</Copyright>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>

</Project>
